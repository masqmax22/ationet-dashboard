# Credenciales de la API de Ationet — copiá este archivo a .env.local
# para desarrollo local. Se leen SOLO del lado servidor (nunca llegan al navegador).
#
#   cp .env.local.example .env.local

# URL base de la API de Ationet (valor por defecto mostrado).
ATIONET_BASE_URL=https://api.ationet.com

# Credenciales OAuth (grant_type=password)
ATIONET_USERNAME=
ATIONET_PASSWORD=

# Identificadores de la red (de tu cuenta Ationet)
ATIONET_NETWORK_ID=
ATIONET_NETWORK_NAME=

# Tipo de entidad — "N" para red (network). Por defecto: N
ATIONET_ENTITY_TYPE=N
